# Snowflake credentials for reading BULLHORN_MIRROR (the live Bullhorn data).
# This is the SAME service account the Tickler portal uses (role CLAUDEAI, which
# reads BULLHORN_MIRROR). Copy its real values from the Tickler app's
# .streamlit/secrets.toml — do NOT commit the filled-in file.
#
# LOCAL: copy this to `.streamlit/secrets.toml` and point private_key_file at the
#        key on disk (same path the Tickler app uses).
# CLOUD: in Streamlit Community Cloud -> Manage app -> Settings -> Secrets, paste
#        the account/user/role/warehouse/database/schema lines plus a
#        `private_key_pem = """-----BEGIN PRIVATE KEY----- ... """` block
#        (there is no filesystem on Cloud for a key file). The Tickler app's
#        secrets.cloud.toml is the template for that paste.
#
# Key-pair auth is required (the account has MFA on password and no SSO IdP).

[connections.snowflake]
account          = "<same as Tickler>"
user             = "<same as Tickler>"
role             = "<same as Tickler>"        # CLAUDEAI
warehouse        = "<same as Tickler>"
database         = "BULLHORN_MIRROR"
schema           = "RAW"
private_key_file = "<path to the .p8 key on this machine>"
# On Cloud instead of private_key_file:
# private_key_pem = """-----BEGIN PRIVATE KEY-----
# ...
# -----END PRIVATE KEY-----"""
