# Copy to .streamlit/secrets.toml for local work, or paste into the app's
# Secrets box on Streamlit Community Cloud. Never commit the real file.
#
# Note what is NOT here: any identity provider configuration. Portal
# accounts are self-contained — an administrator creates each username,
# password and Bullhorn mapping from the Accounts page inside the app.
# The first time the app runs with an empty account table it shows a
# one-time screen to create the administrator, and never again.

[connections.snowflake]
account   = "OYB76494"
user      = "TICKLER_APP"
role      = "CLAUDE_WRITER"
warehouse = "CLAUDE_WH"
database  = "BULLHORN_MIRROR"
schema    = "ANALYTICS"

# Prefer a key pair over a password for a service account.
private_key_file = "/path/to/rsa_key.p8"
# private_key_file_pwd = "..."
# password = "..."
