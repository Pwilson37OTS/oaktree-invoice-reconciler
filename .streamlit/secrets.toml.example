# Copy to .streamlit/secrets.toml for local work (that file is gitignored), or
# paste into the app's Secrets box on Streamlit Community Cloud. Never commit the
# real file or the private key.
#
# Read-only service account for BULLHORN_MIRROR, the same account the Tickler
# portal uses. Role CLAUDEAI inherits CLAUDE_WRITER, which has read on the mirror.
# The account has MFA on its password and no SSO, so authenticate with a key pair.
#
# Local:          set private_key_file to the .p8 path on disk.
# Streamlit Cloud: there is no filesystem, so omit private_key_file and instead
#                 paste the key inline as private_key_pem (mirror.py converts the
#                 PEM to the DER bytes the connector wants).

[connections.snowflake]
account          = "OYB76494"
user             = "OAKTREESTAFFING"
role             = "CLAUDEAI"
warehouse        = "CLAUDE_WH"
database         = "BULLHORN_MIRROR"
schema           = "ANALYTICS"

# Key-pair auth. Use ONE of these:
private_key_file = "C:/Users/<you>/.snowflake/rsa_key.p8"   # local path
# private_key_pem = """-----BEGIN PRIVATE KEY-----
# ...
# -----END PRIVATE KEY-----"""                              # Streamlit Cloud
